/*
 * Jenkins 声明式流水线
 * Jenkins 流水线 — 通过 Gerrit Trigger + PATCHSET_REVISION 检出
 * 阶段: Checkout → 编译 → 单元测试 → 集成测试 → 打包 → 报告
 */

pipeline {
    agent any

    environment {
        SPRING_PROFILES_ACTIVE = 'test'
        MAVEN_OPTS = '-Xmx1024m'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '========== 检出代码 (Gerrit) =========='
                checkout scm
            }
        }

        stage('编译') {
            steps {
                echo '========== Maven 编译 =========='
                sh 'mvn clean compile -DskipTests'
            }
        }

        stage('单元测试') {
            steps {
                echo '========== 运行单元测试 =========='
                sh 'mvn test'
            }
            post {
                always {
                    junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('集成测试') {
            steps {
                echo '========== 运行集成测试（H2 内存数据库）=========='
                sh 'mvn verify -P test'
            }
            post {
                always {
                    junit testResults: 'target/failsafe-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('打包') {
            steps {
                echo '========== 打包 JAR =========='
                sh 'mvn package -DskipTests'
            }
        }
    }

    post {
        success {
            echo '========== 流水线执行成功 =========='
            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
        }
        failure {
            echo '========== 流水线执行失败 =========='
        }
        unstable {
            echo '========== 流水线结果不稳定（测试有失败）=========='
        }
        always {
            cleanWs()
        }
    }
}
